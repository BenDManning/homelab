[Unit]
Description=Offsite home-reachability observer
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=offsite-watchdog
Group=offsite-watchdog
ExecStart=/usr/bin/python3 /opt/offsite-watchdog/watchdog.py --config %d/config.json --credentials %d/publisher.json
LoadCredential=config.json:/etc/offsite-watchdog/config.json
LoadCredential=publisher.json:/etc/offsite-watchdog/publisher.json
StateDirectory=offsite-watchdog
StateDirectoryMode=0700
UMask=0077
Environment=PYTHONDONTWRITEBYTECODE=1
TimeoutStartSec=45s
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
LockPersonality=yes
MemoryMax=96M
CPUQuota=25%
TasksMax=32
LimitNOFILE=128
